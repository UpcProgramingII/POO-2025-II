<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="900" style="-fx-background-color: #ECF0F1;" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.parqueo.javafx.InformeViewController">

    <children>
        <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">
            
            <!-- Título -->
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Informe de Parqueos" />

            <!-- Filtros -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 14px;" text="Filtrar por placa:" />
                <TextField fx:id="txtFiltroPlaca" prefWidth="200" promptText="Ingrese placa (Ej. ABC123)" />
                <Button fx:id="btnFiltrar" onAction="#handleFiltrar" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold;" text="Filtrar" />
                <Button fx:id="btnLimpiar" onAction="#handleLimpiar" style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-weight: bold;" text="Mostrar Todo" />
            </HBox>

            <!-- Tabla -->
            <TableView fx:id="tblParqueos" prefHeight="450" prefWidth="850">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colHoraInicio" prefWidth="120" text="Hora Ingreso" />
                    <TableColumn fx:id="colHoraFin" prefWidth="120" text="Hora Salida" />
                    <TableColumn fx:id="colDuracion" prefWidth="100" text="Duración" />
                    <TableColumn fx:id="colPlaca" prefWidth="120" text="Placa Vehículo" />
                    <TableColumn fx:id="colCosto" prefWidth="100" text="Costo ($)" />
                    <TableColumn fx:id="colActivo" prefWidth="80" text="Activo" />
                </columns>
            </TableView>

            <Label fx:id="lblTotalRegistros" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Total registros: 0" />
         <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <children>
               <BarChart fx:id="grafico" prefHeight="204.0" prefWidth="500.0">
                 <xAxis>
                   <CategoryAxis side="BOTTOM" />
                 </xAxis>
                 <yAxis>
                   <NumberAxis side="LEFT" />
                 </yAxis>
               </BarChart>
               <PieChart fx:id="grafico2" />
            </children>
         </HBox>
        </VBox>
    </children>
</AnchorPane>
